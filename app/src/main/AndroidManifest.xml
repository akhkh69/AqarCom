<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".AqarComApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AqarCom">

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AqarCom.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.LoginActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.RegisterActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.ForgotPasswordActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.PendingApprovalActivity" />
        <activity android:name=".ui.main.MainActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".ui.main.FavoritesActivity" />

        <activity android:name=".ui.property.PropertyDetailActivity" />
        <activity android:name=".ui.property.PropertyFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.property.LocationPickerActivity" />
        <activity android:name=".ui.property.MyPropertiesActivity" />

        <activity android:name=".ui.tender.TenderDetailActivity" />
        <activity android:name=".ui.tender.TenderFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tender.ShortlistActivity" />
        <activity android:name=".ui.tender.MyBidsActivity" />

        <activity android:name=".ui.account.VerificationActivity" />
        <activity android:name=".ui.account.EditProfileActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.account.ChangePasswordActivity" android:windowSoftInputMode="adjustResize" />

        <!-- opens downloaded spec books with an external PDF / Word viewer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
