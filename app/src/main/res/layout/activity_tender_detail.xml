<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aq_sand"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/nav_tenders" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:indicatorColor="@color/aq_gold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/gutter">

                    <!-- header -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="10dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="2dp"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_type"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_tag"
                                    android:paddingStart="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="2dp"
                                    android:textColor="@color/aq_blue"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textAppearance="@style/TextAppearance.Aq.Headline" />

                            <TextView
                                android:id="@+id/tv_owner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:drawablePadding="4dp"
                                android:gravity="center_vertical"
                                android:textAppearance="@style/TextAppearance.Aq.Body"
                                app:drawableStartCompat="@drawable/ic_business"
                                app:drawableTint="@color/aq_ink_3" />

                            <TextView
                                android:id="@+id/tv_budget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.Aq.Body"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- countdown -->
                    <LinearLayout
                        android:id="@+id/card_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_countdown"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_countdown_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/time_remaining"
                            android:textColor="@color/aq_blue_50" />

                        <TextView
                            android:id="@+id/tv_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/white"
                            android:textDirection="ltr"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_deadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/aq_blue_50"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- weights -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/weights"
                        android:textAppearance="@style/TextAppearance.Aq.Section" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_price_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Aq.Body" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/bar_price"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                app:indicatorColor="@color/aq_gold"
                                app:trackColor="@color/aq_line_2"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp" />

                            <TextView
                                android:id="@+id/tv_duration_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textAppearance="@style/TextAppearance.Aq.Body" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/bar_duration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                app:indicatorColor="@color/aq_blue"
                                app:trackColor="@color/aq_line_2"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/label_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/description"
                        android:textAppearance="@style/TextAppearance.Aq.Section" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:textAppearance="@style/TextAppearance.Aq.Body" />

                    <!-- spec book -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/spec_book"
                        android:textAppearance="@style/TextAppearance.Aq.Section" />

                    <LinearLayout
                        android:id="@+id/list_documents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_upload_doc"
                        style="@style/AqButton.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/upload_new_version"
                        android:visibility="gone"
                        app:icon="@drawable/ic_upload" />

                    <!-- contractor: my bid -->
                    <LinearLayout
                        android:id="@+id/group_contractor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/my_bid"
                            android:textAppearance="@style/TextAppearance.Aq.Section" />

                        <TextView
                            android:id="@+id/tv_verify_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_callout"
                            android:padding="12dp"
                            android:text="@string/verify_to_bid"
                            android:textColor="@color/aq_ink_2"
                            android:visibility="gone" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_my_bid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_bid_price"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textAppearance="@style/TextAppearance.Aq.Price" />

                                    <TextView
                                        android:id="@+id/tv_bid_outcome"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingStart="10dp"
                                        android:paddingTop="2dp"
                                        android:paddingEnd="10dp"
                                        android:paddingBottom="2dp"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_bid_days"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/TextAppearance.Aq.Body" />

                                <TextView
                                    android:id="@+id/tv_bid_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.Aq.Caption" />

                                <LinearLayout
                                    android:id="@+id/group_bid_actions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btn_edit_bid"
                                        style="@style/AqButton.Outlined"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/edit_bid"
                                        app:icon="@drawable/ic_edit" />

                                    <Space
                                        android:layout_width="10dp"
                                        android:layout_height="1dp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btn_withdraw_bid"
                                        style="@style/AqButton.Danger"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/withdraw_bid" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_submit_bid"
                            style="@style/AqButton.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/submit_bid"
                            android:visibility="gone"
                            app:icon="@drawable/ic_gavel" />
                    </LinearLayout>

                    <!-- project owner -->
                    <LinearLayout
                        android:id="@+id/group_owner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/my_tenders"
                            android:textAppearance="@style/TextAppearance.Aq.Section" />

                        <TextView
                            android:id="@+id/tv_owner_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_callout"
                            android:padding="12dp"
                            android:textColor="@color/aq_ink_2" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_shortlist"
                            style="@style/AqButton.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/view_shortlist"
                            app:icon="@drawable/ic_star" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_publish"
                            style="@style/AqButton.Green"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/publish_now"
                            app:icon="@drawable/ic_check" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_tender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/edit"
                            app:icon="@drawable/ic_edit" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_extend"
                            style="@style/AqButton.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/extend_deadline"
                            app:icon="@drawable/ic_schedule" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_tender"
                            style="@style/AqButton.Danger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/cancel_tender" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            android:id="@+id/state"
            layout="@layout/view_state" />
    </FrameLayout>
</LinearLayout>
